# Copy to .env and fill in your values
# Web API token — protects all /api/* endpoints (generate: python3 -c "import secrets; print(secrets.token_hex(32))")
API_TOKEN=your_web_api_token_here
# Phase A needs no market-data credentials — yfinance is unauthenticated.
# Primary Telegram channel — full trader-facing alert (LONG/SHORT, strategy reasons, edge, stats)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Wife Telegram channel — minimal BUY/HOLD-relabelled alert (no strategy jargon)
TELEGRAM_BOT_TOKEN_2=your_wife_telegram_bot_token_here
TELEGRAM_CHAT_ID_2=your_wife_telegram_chat_id_here
# Set to 1 to log wife-channel messages instead of sending (rollout safety)
TELEGRAM_WIFE_DRY_RUN=

# --- /ingest-video (optional) ---
# Groq key for whisper-large-v3, used ONLY when a video has no captions —
# most YouTube video is captioned and costs nothing. Free tier is sufficient.
# Leave empty and caption-less videos (nearly all X video) are skipped with a
# health note rather than transcribed.
GROQ_API_KEY=

# --- /ingest-feed (optional) ---
# YouTube Data API v3 key (key-only, no OAuth). Restrict it to the YouTube Data
# API in the GCP console. `poll` costs ~2-3 units/channel/day and never calls
# search.list, so the free 10k/day quota is ample.
YOUTUBE_API_KEY=

# --- SEC EDGAR (REQUIRED — PEAD and insider sleeves) ---
# SEC fair-access requires automated clients to identify themselves with a
# reachable contact. Keep it HERE, never in source — this repo is public.
# ⚠ Unset is a hard failure rather than a slowdown: a User-Agent carrying a URL,
# or no contact at all, is 403'd by BOTH SEC hosts (measured 2026-08-29), so the
# fetchers raise EdgarContactMissing instead of fetching.
EDGAR_CONTACT_EMAIL=
