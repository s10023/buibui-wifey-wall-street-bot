venv/
__pycache__/
*.pyc
.env
.coverage

# Ignore config/stocks.json (Phase A personal watchlist — ship .example instead)
config/stocks.json
# Personal YouTube follow list for /ingest-feed (example is committed)
config/youtube_channels.toml

# But don't ignore other files in config/
!config/
.claude/*
# Allowlist over .claude/* — every artifact class defaults to IGNORED until it is
# named here, so a new one dies silently on clone. A directory entry is enough:
# git descends into a re-included directory, so no per-extension glob is needed.
!.claude/skills
!.claude/agents
!.claude/context
!.claude/context/*.md
.idea/

# Local planning docs — personal notes, not for public repo
docs/plans/

# DuckDB data files
*.db
*.db.wal
*.db.bak

# Signal daemon runtime state
signal_state.json

# Frontend build artifacts
web/ui/node_modules/
web/ui/dist/
web/ui/.env.local
web/ui/.vite/

# Skills system
skills-lock.json
.agents/

# X-post ingest (and research-ingestion) caches
.cache/
