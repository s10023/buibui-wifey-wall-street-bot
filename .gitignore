venv/
__pycache__/
*.pyc
# Every .env variant, not just the exact name: a .env.bak from an edit is
# untracked but fully committable under a bare `.env`.
.env*
!.env.example
.coverage

# Ignore config/stocks.json (Phase A personal watchlist — ship .example instead)
config/stocks.json
# Personal YouTube follow list for /ingest-feed (example is committed)
config/youtube_channels.toml

# But don't ignore other files in config/
!config/
# .claude/ is a DENYLIST, inverted from an allowlist 2026-08-20. Under the allowlist
# every artifact class defaulted to IGNORED until someone named it, so a new class died
# silently on clone — hooks were the class that bit, and CLAUDE.md carried "re-add it
# after a reclone" for three of them. Name only what must NOT ship; anything new is
# tracked by default, which fails loudly (a review) rather than silently (an absence).
# Machine-local: permissions allowlist, carries absolute /home paths.
.claude/settings.local.json
# Per-session scratch state, rewritten constantly.
.claude/RESUME.md
# Pre-flip sensitive-term list. NEVER tracked — it is the enumeration of what must not
# be published, so committing it publishes exactly the thing it exists to catch.
.claude/sensitive-terms.txt
# Skill-usage log appended by .claude/hooks/log-skill-usage.py (#395). Machine-local evidence.
.claude/skill-usage.log
.idea/

# Local planning docs — personal notes, not for public repo
docs/plans/

# DuckDB data files
*.db
*.db.wal
# Glob, not the bare name: a DATED rollback copy (analytics.db.bak.2026-08-14,
# kept when migration 004 needed a fresh .bak) is 155MB and `*.db.bak` alone
# does not match it, so it sat untracked where `git add -A` would commit it.
*.db.bak*

# Signal daemon runtime state
signal_state.json

# Frontend build artifacts
web/ui/node_modules/
web/ui/dist/
web/ui/.env.local
web/ui/.vite/

# Skills system
skills-lock.json
.agents/

# X-post ingest (and research-ingestion) caches
.cache/

# Windows scheduled-job logs (deploy/windows/job.sh, WIFEY_LOG_DIR default)
/logs/
