[Unit]
# Pulled in by `OnFailure=` on wifey-backup.service. Not timed, not enabled --
# systemd starts it only when the backup unit fails.
Description=Telegram alert for a failed wifey backup

[Service]
Type=oneshot
WorkingDirectory=/home/kng/repo/buibui-wifey-wall-street-bot
EnvironmentFile=-/home/kng/repo/buibui-wifey-wall-street-bot/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=wifey-backup-alert
ExecStart=/home/kng/repo/buibui-wifey-wall-street-bot/deploy/notify-failure.sh wifey-backup
TimeoutStartSec=120
